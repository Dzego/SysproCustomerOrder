{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None"
    }
  },
  "CustomerImport": {
    "MaxInputBytes": 52428800,
    "BatchSize": 1000
  },
  "CustomerImportWorker": {
    "Enabled": true,
    "PollInterval": "00:00:05",
    "MaxAttempts": 3
  },
  "AllowedHosts": "*"
}