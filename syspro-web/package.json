{
  "name": "syspro-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "lint": "ng lint",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"cypress/**/*.ts\" \"*.{js,ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"cypress/**/*.ts\" \"*.{js,ts,json}\"",
    "e2e:open": "cypress open --e2e",
    "e2e": "cypress run --e2e",
    "e2e:fullstack": "CYPRESS_SUITE=fullstack cypress run --e2e",
    "build:dev": "ng build --configuration development",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p cypress/tsconfig.json --noEmit"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "angular-eslint": "21.4.0",
    "cypress": "^16.2.0",
    "eslint": "^10.3.0",
    "jest": "^30.5.2",
    "jest-preset-angular": "^17.0.3",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
